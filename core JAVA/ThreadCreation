class  ThreadCreation  {
    public static void main(String[] args) {
        A ob1 = new A();
        ob1.start();
        
        B ob2 = new B();
        ob2.start();
    }
}

class A extends Thread{
    public void run(){
        
        for(int i = 0; i < 100; i++) System.out.println("I am from class A");
    }
}

class B extends Thread{
    public void run(){
        for(int i = 0; i < 100; i++) System.out.println("I am from class B");
    }}
